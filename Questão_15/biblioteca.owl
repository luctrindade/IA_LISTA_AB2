<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/biblioteca"
         xmlns="https://example.org/biblioteca#">

<owl:Ontology rdf:about="https://example.org/biblioteca"/>

<owl:ObjectProperty rdf:about="#temGenero">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Genero"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temGeneroPrincipal">
  <rdfs:subPropertyOf rdf:resource="#temGenero"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temAutor">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Autor"/>
  <owl:inverseOf rdf:resource="#escreveu"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#escreveu">
  <rdfs:domain rdf:resource="#Autor"/>
  <rdfs:range rdf:resource="#Livro"/>
  <owl:inverseOf rdf:resource="#temAutor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temTema">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Tema"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#temGeneroPrincipal"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#generoAbordaTema"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#generoAbordaTema">
  <rdfs:domain rdf:resource="#Genero"/>
  <rdfs:range rdf:resource="#Tema"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temIdioma">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Idioma"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temNivel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Nivel"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publicadoPor">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Editora"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereGenero">
  <rdfs:domain rdf:resource="#Leitor"/>
  <rdfs:range rdf:resource="#Genero"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereIdioma">
  <rdfs:domain rdf:resource="#Leitor"/>
  <rdfs:range rdf:resource="#Idioma"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#titulo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#codigoCatalogo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sinopse">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#paginas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#anoPublicacao">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomeAutor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Autor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Livro">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temIdioma"/>
      <owl:someValuesFrom rdf:resource="#Idioma"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temGeneroPrincipal"/>
      <owl:someValuesFrom rdf:resource="#Genero"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temNivel"/>
      <owl:someValuesFrom rdf:resource="#Nivel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Romance">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:disjointWith rdf:resource="#Coletanea"/>
</owl:Class>

<owl:Class rdf:about="#Coletanea">
  <rdfs:subClassOf rdf:resource="#Livro"/>
</owl:Class>

<owl:Class rdf:about="#LivroFiccaoCientifica">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGenero"/>
          <owl:hasValue rdf:resource="#FiccaoCientifica"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LeituraIntrodutoria">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temNivel"/>
          <owl:hasValue rdf:resource="#Iniciante"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Leitor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Autor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Genero">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Tema">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Idioma">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Nivel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Editora">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#FiccaoCientifica">
