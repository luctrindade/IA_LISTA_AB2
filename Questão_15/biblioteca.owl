<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#Iniciante"/>
    <rdf:Description rdf:about="#Intermediario"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#Portugues"/>
    <rdf:Description rdf:about="#Ingles"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#FiccaoCientifica"/>
    <rdf:Description rdf:about="#Fantasia"/>
    <rdf:Description rdf:about="#Misterio"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Livro"/>
